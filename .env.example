# Copy to .env and fill in. Never commit .env.
# Local dev defaults (docker-compose) are built in; only override what you need.

APP_ENV=dev                       # dev | test | prod
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
AUTH_SECRET=                      # required in prod: long random string
APP_ENCRYPTION_KEY=               # Fernet key (Phase 4, GSC tokens)

# Datastores (defaults match infra/docker-compose.dev.yml)
DATABASE_URL=postgresql+asyncpg://seomaster:seomaster@localhost:5432/seomaster
REDIS_URL=redis://localhost:6379/0          # cache (Upstash rediss:// in prod)
CELERY_BROKER_URL=redis://localhost:6379/1  # broker (VM redis in prod)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=seomaster
CLICKHOUSE_PASSWORD=seomaster
CLICKHOUSE_DATABASE=seomaster

# Google OAuth (login now, GSC in Phase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Providers (Phase 1+)
DATAFORSEO_LOGIN=                 # account email (app.dataforseo.com/api-access)
DATAFORSEO_PASSWORD=              # API password from that page, not the login password
KEYWORD_PROVIDER_FAKE=false       # true = free fake keyword data even with credentials
SERP_API_PROVIDER=serpapi
SERP_API_KEY=

# Email. Dev default = Mailpit (docker), inbox at http://localhost:8025.
# Prod example (Brevo free tier): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_STARTTLS=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=Brandiz <no-reply@brandiz.local>

# Budget guard (USD per day)
BUDGET_DAILY_GLOBAL_USD=5
BUDGET_DAILY_ORG_USD=1

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Admin pages (cost/cache dashboard). Comma separated emails; empty = any signed-in user outside prod.
ADMIN_EMAILS=
